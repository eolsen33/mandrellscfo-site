# seo-kit: canonical host — send www to the bare domain
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
# /seo-kit
# seo-kit: alias host mandrellscfo.ericolsen.studio → canonical
RewriteCond %{HTTP_HOST} ^mandrellscfo\.ericolsen\.studio$ [NC]
RewriteRule ^ https://mandrellscfo.com%{REQUEST_URI} [R=301,L]
# /seo-kit

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# 301s from the old WordPress site's URLs (pre-cutover structure)
<IfModule mod_alias.c>
  RedirectMatch 301 ^/about-us/?$ /#firm
  RedirectMatch 301 ^/services(/.*)?$ /#services
  RedirectMatch 301 ^/sample-page(/.*)?$ /
  RedirectMatch 301 ^/20[0-9][0-9]/.* /
  RedirectMatch 301 ^/(category|tag|author|feed|comments|wp-content|wp-includes|wp-json|wp-admin|wp-login)(/.*)?$ /
</IfModule>

# seo-kit: crawler files must never sit in a CDN edge — they change with every deploy
<IfModule mod_headers.c>
  <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# /seo-kit
