# seo-kit: canonical host — send www to the bare domain
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
# /seo-kit
# seo-kit: alias host mandrellscfo.ericolsen.studio → canonical
RewriteCond %{HTTP_HOST} ^mandrellscfo\.ericolsen\.studio$ [NC]
RewriteRule ^ https://mandrellscfo.com%{REQUEST_URI} [R=301,L]
# /seo-kit

# Client preview host (preview branch): serve as-is, never index.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host ^mcfo-preview\.ericolsen\.studio$ MCFO_PREVIEW=1
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=MCFO_PREVIEW
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Baseline security headers (added by the 2026-09-21 weekly site check)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 301s from the old WordPress site's URLs (pre-cutover structure)
<IfModule mod_alias.c>
  RedirectMatch 301 ^/about-us/?$ /#firm
  # Old WP /services/... URLs only: anything with a dot (services/*.html) is a real page now.
  RedirectMatch 301 ^/services(/[^.]*)?$ /#services
  RedirectMatch 301 ^/sample-page(/.*)?$ /
  RedirectMatch 301 ^/20[0-9][0-9]/.* /
  RedirectMatch 301 ^/(category|tag|author|feed|comments|wp-content|wp-includes|wp-json|wp-admin|wp-login)(/.*)?$ /
</IfModule>

# seo-kit: crawler files must never sit in a CDN edge — they change with every deploy
<IfModule mod_headers.c>
  <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# /seo-kit

# Keep repo docs and tooling off the web (Hostinger deploys the whole repo).
# Added by the 2026-09-14 weekly site check: /README.md was publicly served.
RedirectMatch 404 ^/[^/]*\.md$
RedirectMatch 404 ^/(_build|_private|_pocketbase|tools|\.impeccable|\.git|\.github)(/|$)
RedirectMatch 404 ^/\.(gitignore|env|DS_Store)

# >>> Content-Security-Policy (OWASP header sweep 2026-11-24)
# Built from a browser crawl of every page plus a scan of the site's own files, then re-crawled
# to prove nothing is blocked. If you add a third-party script, font, embed, form target or API
# host to the site, ADD IT HERE TOO or browsers will silently block it.
# Tooling: /Volumes/External 1/DevStorage/audit-tools/csp/ (csp-probe.mjs verify ...)
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.web3forms.com https://formsubmit.co; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
# <<< Content-Security-Policy
